# Copy to .env.local and fill in. Never commit real secrets.

# Anthropic — powers the AI assessment (server-side only). Required.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Resend — sends lead/assessment emails (server-side only). Required for the contact form.
RESEND_API_KEY=re_xxxxxxxx

# Cloudflare Turnstile — anti-bot on the public POST endpoints. Optional but
# strongly recommended in production. Create an INVISIBLE widget in the
# Cloudflare dashboard. If unset, the Turnstile check is skipped (no-op).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics & Ads (client-side). All optional — if NEXT_PUBLIC_GA_ID is unset,
# gtag, the consent banner, and all tracking are no-ops.
# GA4 measurement id.
NEXT_PUBLIC_GA_ID=
# Google Ads conversion id (links GA4 conversions to Ads bidding).
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion action for an enquiry, e.g. AW-1234567890/AbC-D_efGh
NEXT_PUBLIC_ADS_ENQUIRY_LABEL=
